generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Manager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String     @id @default(uuid())
  name           String     @unique
  slug           String     @unique
  description    String?
  parentCategory String     @default("FOOD") // "FOOD" | "DRINKS"
  sortOrder      Int        @default(0)
  icon           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float?
  image       String?
  isAvailable Boolean  @default(true)
  tags        String?
  sortOrder   Int      @default(0)
  viewsCount  Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  type        String   // "PAGE_VIEW" | "TABLE_SCAN" | "ITEM_VIEW"
  tableNumber String?
  itemId      String?
  itemName    String?
  createdAt   DateTime @default(now())
}

model ServiceRequest {
  id            String   @id @default(uuid())
  tableNumber   String
  type          String   // "CALL_WAITER" | "REQUEST_BILL"
  paymentMethod String?
  notes         String?
  status        String   @default("PENDING") // "PENDING" | "COMPLETED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id                    String   @id @default("default")
  restaurantName        String   @default("KABUN COFFEE + ROASTERY")
  tagline               String   @default("CRAFTED FROM COFFEE")
  heroTitle1            String   @default("CRAFTED FROM")
  heroTitle2            String   @default("COFFEE")
  heroDescription       String   @default("Upscale specialty coffee roastery in Mekelle. Experience single-origin Ethiopian beans roasted with precision, slow-steeped cold brews, artisanal espresso creations, and freshly baked viennoiserie.")
  primaryCtaText        String   @default("EXPLORE ROASTERY MENU")
  secondaryCtaText      String   @default("OUR ROASTERY CRAFT")

  wifiSsid              String   @default("Kabun_Guest_WiFi")
  wifiPassword          String   @default("craftedfromcoffee")

  philosophyEyebrow     String   @default("Our Roastery Craft")
  philosophyTitle       String   @default("BORN IN ETHIOPIA.\nCRAFTED WITH OBSESSIVE PASSION.")
  philosophyDescription String   @default("Kabun is more than a café — it is a sanctuary for coffee lovers, artists, and conversation. We source exceptional micro-lots from Yirgacheffe, Guji, and Sidama, hand-roasting small batches to honor Ethiopia's coffee heritage in a modern architectural lounge.")
  manifestoQuote        String   @default("Every great conversation begins with an exceptional roast.")
  manifestoAuthor       String   @default("The Roaster's Manifesto")

  galleryTitle          String   @default("ATMOSPHERE & ARTISAN ROASTS")
  galleryDescription    String   @default("A glimpse into our warm wood interiors, illuminated night storefront, aromatic pour-over bar, and shared moments at Kabun.")

  addressLine1          String   @default("Mekelle, Tigray, Ethiopia")
  addressLine2          String   @default("ካቡን ኮፊ እና ሮስተሪ (Kebele 17 / Main Roastery)")
  openingHours          String   @default("7:00 AM – 10:30 PM")
  phone1                String   @default("0914000000")
  phone2                String   @default("0920000000")
  instagramHandle       String   @default("@KABUNCOFFEE")
  instagramUrl          String   @default("https://www.instagram.com/kabuncoffee/")
  tiktokHandle          String   @default("@KABUNCOFFEE")
  tiktokUrl             String   @default("https://www.tiktok.com/@kabuncoffee")
  facebookHandle        String   @default("FB: KABUN COFFEE + ROASTERY - ካቡን")
  facebookUrl           String   @default("https://www.facebook.com/search/top?q=KABUN%20COFFEE%20ROASTERY")

  accentColor           String   @default("#E5CFAF")
  backgroundColor       String   @default("#0E2F2C")
  cardColor             String   @default("#143834")
  fontFamily            String   @default("Outfit, sans-serif")

  updatedAt             DateTime @updatedAt
}
